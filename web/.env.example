# ─── Detlio web — environment template ───────────────────────────────────────
#
# Copy to `.env` and fill in:
#
#   cp web/.env.example web/.env
#
# Anything prefixed NEXT_PUBLIC_ is inlined into the browser bundle. Never put a
# secret behind that prefix — the map provider key deliberately lives on the
# API instead (see server/.env.example), which is why address search is proxied
# through /api/v1/geo rather than called from the browser.

NODE_ENV=development

# Where the browser reaches the API. Defaults to http://localhost:8080/api/v1.
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1

# Host-based routing for the vendor and admin surfaces (see middleware.ts).
NEXT_PUBLIC_VENDOR_HOST=vendor.localhost:3000
NEXT_PUBLIC_ADMIN_HOST=admin.localhost:3000

# Razorpay publishable key. Public by design — the secret stays server-side.
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx

# Shown in the UI footer / build info.
NEXT_PUBLIC_APP_VERSION=

# ─── Map tiles ───────────────────────────────────────────────────────────────
# Optional. Both default to OpenFreeMap, which needs no key, no registration
# and has no documented request limit — tiles are by far the highest-volume map
# call, so getting them to genuinely zero is the biggest cost lever.
#
# OpenFreeMap is a donation-funded public instance with no SLA, which is exactly
# why these are env vars: switching to MapTiler (100k requests/month free, no
# card) or Carto is a config change, not a code change.
#
# The app renders dark-only, so in practice only the DARK style is used — see
# MAP_THEME in web/lib/map.ts. The light one is here for if a light mode lands.
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron
NEXT_PUBLIC_MAP_STYLE_URL_DARK=https://tiles.openfreemap.org/styles/dark

# ─── Deployment (Vercel) ─────────────────────────────────────────────────────
BACKEND_URL=
