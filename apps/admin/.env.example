# ─── Detlio operations panel — environment template ───────────────────────────────────
#
# Copy to `.env` and fill in:
#
#   cp apps/admin/.env.example apps/admin/.env
#
# Anything prefixed NEXT_PUBLIC_ is inlined into the browser bundle. Never put a
# secret behind that prefix.

NODE_ENV=development

# Where the browser reaches the API.
#
#   local        http://localhost:8080/api/v1
#   production   https://api.detlio.com/api/v1
#   preview      /api/v1   (routed through this app's own proxy; see BACKEND_URL)
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1

# Only used when NEXT_PUBLIC_API_URL is the relative /api/v1 form, which routes
# through app/api/v1/[...path]/route.ts. Preview deployments only: *.vercel.app
# is a different site from api.detlio.com, so the session cookies would not be
# sent to it directly. Leave empty in production.
BACKEND_URL=

# ─── Map tiles ───────────────────────────────────────────────────────────────
# Optional. Both default to OpenFreeMap, which needs no key. See
# apps/users/.env.example for why these are configurable.
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron
NEXT_PUBLIC_MAP_STYLE_URL_DARK=https://tiles.openfreemap.org/styles/dark

# ─── Crash reporting (Sentry) ────────────────────────────────────────────────
# The DSN of this app's Sentry project. Public by design — it only lets
# someone send errors in, not read them — so the NEXT_PUBLIC_ prefix is fine.
# Unset (as in development, E2E and previews) and Sentry is never loaded and
# nothing is sent. Set it in the Vercel Production environment only; it is
# read at build time, so redeploy after changing it. No auth token or
# source-map upload is needed: builds never talk to Sentry.
NEXT_PUBLIC_SENTRY_DSN=

# The Detlio Garage (0057): the card photos live with the customer site
# (apps/users/public/cards/cars); admin shows them from there. Default
# https://detlio.com; in development the users app, e.g. http://localhost:3000
NEXT_PUBLIC_CARD_PHOTOS_URL=http://localhost:3000

# Microsoft Clarity's project id, the same as the customer app's
# NEXT_PUBLIC_CLARITY_ID: Statistics → Behaviour links to its recordings.
# Unset and the link is hidden. Read at build time.
NEXT_PUBLIC_CLARITY_ID=
