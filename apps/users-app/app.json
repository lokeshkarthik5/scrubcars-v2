{
  "expo": {
    "name": "Detlio",
    "slug": "detlio",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "detlio",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.detlio.app",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.detlio.app"
    },
    "web": {
      "bundler": "metro",
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#0A0A0B"
        }
      ],
      "expo-secure-store",
      "expo-font",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Detlio uses your location to show the nearest garages. It is only read when you ask for it."
        }
      ],
      "expo-notifications",
      [
        "expo-camera",
        {
          "cameraPermission": "Detlio uses your camera to photograph your car, check how it shines, record a repair, and scan a coupon.",
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Detlio uses your photos so you can add a profile picture, a photo of your car, a shine check, or a repair.",
          "cameraPermission": "Detlio uses your camera to photograph your car, check how it shines, record a repair, and scan a coupon.",
          "microphonePermission": "Detlio uses the microphone while you record a repair video."
        }
      ],
      "expo-sharing",
      "expo-video",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Detlio uses Face ID to unlock the app, only if you turn the lock on in Profile."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
