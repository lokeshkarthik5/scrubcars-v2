{
  "name": "server",
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts | pino-pretty --colorize --translateTime 'HH:MM:ss' --ignore 'pid,hostname,service'",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js",
    "migrate": "bash scripts/migrate.sh migrate",
    "migrate:status": "bash scripts/migrate.sh status",
    "migrate:check": "bash scripts/migrate.sh check",
    "seed": "bash scripts/seed.sh",
    "seed:users": "bash scripts/seed.sh --users",
    "seed:vendors": "bash scripts/seed.sh --vendors",
    "alerts:telegram": "tsx scripts/telegram-setup.ts",
    "test": "bun test"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1101.0",
    "@aws-sdk/s3-request-presigner": "^3.1101.0",
    "@hono/node-server": "^2.0.6",
    "@hono/zod-validator": "^0.8.0",
    "@sentry/node": "^11.4.0",
    "@vercel/functions": "^3.9.11",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.27",
    "pino": "^10.3.1",
    "postgres": "^3.4.9",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "@types/node": "^20.11.17",
    "@types/pg": "^8.20.0",
    "drizzle-kit": "^0.31.10",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.22.4",
    "typescript": "^5.8.3"
  }
}
