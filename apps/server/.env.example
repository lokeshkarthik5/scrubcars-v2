# ─── Detlio API — environment template ───────────────────────────────────────
#
# Copy to `.env` and fill in. Every value here is a placeholder; nothing in this
# file is a real credential.
#
#   cp server/.env.example server/.env
#
# Values marked REQUIRED have no usable default in production — the process
# either refuses to boot without them (see src/lib/env.ts) or the feature they
# power is off until they are set.

# ─── Database ────────────────────────────────────────────────────────────────
# REQUIRED. Supabase pooled connection (port 6543) — what the API runs on.
DATABASE_URL=postgresql://user:password@host.pooler.supabase.com:6543/postgres?pgbouncer=true
# REQUIRED for migrations only. Direct connection (port 5432): `scripts/migrate.sh`
# needs a session it can hold and a role that can CREATE EXTENSION, which the
# transaction pooler cannot give it.
DIRECT_URL=postgresql://user:password@host.pooler.supabase.com:5432/postgres

# Logs every SQL statement. Noisy; local debugging only.
LOG_QUERIES=false

# ─── Runtime ─────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=8080
# Comma-separated. Defaults to localhost plus the three production hosts.
# Every origin allowed to call this API with credentials. The three frontends
# are separate deployments on separate hosts and call the API directly, so each
# one needs a seat here — locally that is users 3000, vendors 3001, admin 3002.
# Omitting a host does not fail loudly: the browser blocks the response and the
# app just looks broken.
CORS_ORIGIN=http://localhost:3000,http://localhost:3001,http://localhost:3002

# ─── Auth ────────────────────────────────────────────────────────────────────
# REQUIRED in production; falls back to a dev-only literal otherwise.
JWT_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_DAYS=30

# Admin portal sign-in. ADMIN_PASSWORD is REQUIRED in production.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
ADMIN_TOKEN_EXPIRES_IN=12h

# ─── SMS (OTP delivery) ──────────────────────────────────────────────────────
# Unset in development: OTPs are logged instead of sent.
SMS=

# ─── Ops alerts (Telegram) ───────────────────────────────────────────────────
# Booking events posted to the Detlio team's Telegram group. Set both in the
# Vercel PRODUCTION environment only; the server sends from Production and
# nowhere else (OPS_ALERTS=on forces it for a deliberate local test). Keep
# them out of this file locally: E2E and dev would otherwise read them too.
# Finding the group id and testing, with the values on the command line:
#   TELEGRAM_BOT_TOKEN=… bun run alerts:telegram
#   TELEGRAM_BOT_TOKEN=… TELEGRAM_OPS_CHAT_ID=… bun run alerts:telegram --test
TELEGRAM_BOT_TOKEN=
TELEGRAM_OPS_CHAT_ID=
# Admin → Alerts → "Send test alert": tests each admin may post an hour.
TELEGRAM_TEST_RATE_LIMIT=5

# ─── Browser notifications (Web Push) ────────────────────────────────────────
# Free notifications for garages (new bookings) and customers (their bookings,
# reminders), through the browser. One VAPID key pair for the API, made once:
#
#   bunx web-push generate-vapid-keys
#
# The public key goes to browsers when they subscribe; the private key signs
# every send and lives only in the Vercel environment (Production, and
# Preview if previews should send). VAPID_SUBJECT is how a push service can
# reach us: a mailto: address. Leave any of the three empty and notifications
# are off: their routes 404 and the apps hide them. Setup and rotation:
# docs/push-notifications.md. Changing the key pair means every device must
# turn notifications on again.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@detlio.com
# E2E only: record notifications instead of sending them (needs only the
# public key). The server refuses to boot with it in production.
# PUSH_FAKE=1

# ─── Crash reporting (Sentry) ────────────────────────────────────────────────
# The DSN of the API's Sentry project (a Node project, separate from the three
# web apps'). Unset — as in development, E2E and previews — and the SDK is
# never even loaded. Set it in the Vercel PRODUCTION environment only. Only
# unexpected errors are reported (a 500, an upstream timeout, a background job
# that threw), with phone numbers and 6-digit codes scrubbed out first; see
# src/lib/monitoring.ts.
SENTRY_DSN=

# ─── Scheduled jobs ──────────────────────────────────────────────────────────
# Shared secret an outside scheduler sends as `Authorization: Bearer <secret>`
# to POST /api/v1/ops/pending-digest every 10 minutes (the 30-minute nudge for
# bookings no garage has accepted). Generate with `openssl rand -hex 32`.
# Vercel Production only. Unset or under 32 characters = the endpoint is 404.
CRON_SECRET=

# ─── Payments (Razorpay) ─────────────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=
# Verifies webhook signatures. Without it, webhook-confirmed bookings are
# rejected — the client callback still works, so this is easy to miss in dev.
RAZORPAY_WEBHOOK_SECRET=

# ─── Refunds through Razorpay ────────────────────────────────────────────────
# Admin's "Refund now" sends a refund through Razorpay (normal speed, from the
# Razorpay balance, which must cover it) whatever these say. The Razorpay
# webhook must also send `refund.processed` and `refund.failed`: a failed
# refund then shows as owed again and the team is told.
#
# Automatic refunds: off unless set to exactly `on`. When on, the clear-cut
# cases (garage declined or no-show, customer cancelled in time, Detlio
# cancelled, a checkout paid with no booking) are refunded right after the
# cancel, and the pending-digest cron (CRON_SECRET) retries what was missed,
# up to 20 a run. Final-bill money, part refunds and bookings with an open
# complaint always wait for a person.
AUTO_REFUNDS=off
# The most automatic refunds may send in a day (IST), in rupees. Once reached,
# they stop until tomorrow and the team gets one Telegram alert. Default 20000.
AUTO_REFUND_DAILY_CAP_INR=20000

# ─── Gift a wash (Detlio gifts and credit) ───────────────────────────────────
# Customers buy a Detlio gift (₹300–₹5,000, paid through Razorpay) and share a
# link; whoever opens it redeems it as Detlio credit, spent at checkout. Off
# unless set to exactly `on`: every gift and credit route but /config is a
# 404 and the apps hide it. Keep it off until the owner's lawyer/CA has
# confirmed the structure (prepaid instrument rules; apps/users/lib/legal/gifts.ts).
GIFTS_ENABLED=off

# ─── Detlio Rewards (Shine Card, scratch cards, streaks, levels, invites) ─────
# Completed bookings paid through Detlio earn stamps and scratch cards; rewards
# are Detlio-funded vouchers spent at checkout (the garage is paid in full).
# The master switch: off unless set to exactly `on`. While off every rewards
# route but /config is a 404, the apps hide it, nothing is earned and vouchers
# are refused at checkout. Admin → Rewards → Settings has its own switch (it
# works only while this is on) and every number, the monthly budget included.
REWARDS_ENABLED=off

# ─── Garage response deadline ────────────────────────────────────────────────
# A garage has this many minutes of its opening hours to accept (or reject, or
# suggest other times for) a paid booking. Paid while it is shut, the clock
# starts when it next opens. Never later than 1 hour before the slot, with at
# least 15 minutes from payment (never past the slot's start). Whole minutes,
# 5–240; default 30. Shown to the garage and the customer either way.
GARAGE_RESPONSE_MINUTES=30
# Cancel a paid booking the garage did not answer in time, as the garage's
# decline with a full refund (AUTO_REFUNDS then sends it like any decline):
# off unless set to exactly `on`. While off, the deadline is only guidance:
# Accept is never refused for it and the pending-digest cron cancels nothing.
# Tell the garages before turning it on.
AUTO_CANCEL_UNANSWERED=off

# ─── Job photo standards (0045) ──────────────────────────────────────────────
# Garages must add 2 before photos to start a job and 2 after photos to finish
# it (pickup & drop: before Out for delivery and Delivered). Off unless set to
# `on` (pilot default: garages are nudged, not blocked). Roll it out garage by
# garage by listing ids in JOB_PHOTOS_REQUIRED_GARAGES (comma separated), then
# set `on` for everyone once most garages take photos. Admin can waive it on
# one booking (Booking → Job photos → Waive).
JOB_PHOTOS_REQUIRED=off
JOB_PHOTOS_REQUIRED_GARAGES=

# ─── Storage (Cloudflare R2) ─────────────────────────────────────────────────
# Vendor logos, gallery photos, service images, user avatars. Uploads are
# disabled when unset; the rest of the API runs fine.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public base URL the bucket is served from, e.g. https://cdn.detlio.com
R2_PUBLIC_BASE_URL=
R2_MAX_PHOTOS_PER_VENDOR=10
R2_MAX_IMAGES_PER_SERVICE=3
R2_UPLOAD_URL_TTL_SECONDS=120
# Garage documents (owner ID, bank proof, the signed agreement): a SECOND,
# PRIVATE bucket in the same account, read with the same keys. Public access
# must be off and it must never have a public URL or custom domain; files are
# only read through 5-minute presigned links the API makes for the garage's
# owner seat or a super-admin. Unset = garage documents are OFF (routes 404,
# the apps hide the section, no "Documents verified" badge). Setup, including
# its CORS rule for uploads: docs/garage-documents.md.
R2_DOCS_BUCKET=

# ─── Service videos (Cloudflare Stream) ──────────────────────────────────────
# A 60-second video per service, uploaded from the phone straight to Stream.
# Video is OFF (no slot in the apps, every video route 404) unless all four
# are set. Real values live only in the Vercel environment, never in git;
# setup steps in docs/service-media.md.
# The Cloudflare account id (dashboard → right-hand side of any zone page).
CLOUDFLARE_ACCOUNT_ID=
# An API token with Stream:Edit on that account and nothing else.
CLOUDFLARE_STREAM_API_TOKEN=
# The <code> in https://customer-<code>.cloudflarestream.com (Stream → any
# video → Embed), where posters and playback are served.
CLOUDFLARE_STREAM_CUSTOMER_CODE=
# The secret Stream returns when the webhook URL is registered; every webhook
# is checked against it.
CLOUDFLARE_STREAM_WEBHOOK_SECRET=
# E2E only, refused in production: uploads go to this API's fake endpoint.
# STREAM_FAKE=1
# STREAM_FAKE_BASE_URL=http://localhost:8080

# ─── Geocoding / maps ────────────────────────────────────────────────────────
# See plans/geo.md §5. Which adapter in src/lib/geo backs address search.
# Ola Maps has the best data for Indian addresses; the adapter exists so this is
# a config change rather than a rewrite when that stops being true.
GEO_PROVIDER=ola

# Address search, forward and reverse geocoding, and driving times.
# Leave empty to run without them: /geo/* returns a clean 503 and the map picker
# still works as a plain drop-a-pin (the pin is the source of truth for
# coordinates — geocoding only prefills the address text).
#
# NOTE: Ola moved to prepaid credits on 2026-09-01, with the first 100k events
# per month free across all products. Our usage sits far below that — garages
# are geocoded once ever, customer location comes free from browser GPS, and
# reverse geocoding only fires when an address is saved.
OLA_MAPS_API_KEY=

# The domain this key is registered against in the Ola console.
#
# Ola authorises API keys against a domain allowlist and reads the ORIGIN header
# to decide — Referer is ignored. A server-side call sends no Origin, so a
# restricted key rejects every request with:
#     403 {"message":"Domain  is not allowed."}
# (note the empty domain in their message — that is the symptom).
#
# Leave unset if the key has no domain restriction, which is the better setup
# for a server-side key: the allowlist is a browser protection, this key never
# reaches a browser, and an Origin header is trivially set by any caller.
OLA_MAPS_ORIGIN=

# How long cached provider responses stay valid (geo_cache table). Generous by
# design: addresses do not move, so the ceiling is how long a genuinely new
# building should take to appear, not correctness. Default 30 days.
GEO_CACHE_TTL_HOURS=720

# Whether an admin may verify a garage that has no pin.
#
# The end state is `true`: an unpinned garage cannot be found by a customer
# browsing nearby, cannot be distance-sorted, and cannot have its doorstep
# coverage checked — letting it go live is letting it fail quietly.
#
# It ships as `false` because that is not where the data is yet. Most garages
# predate the map picker and had their placeholder coordinates nulled by
# migration 0019, so a hard gate would block every verification until the whole
# backlog is revisited. Meanwhile the listing appends unpinned garages after the
# located ones, so they stay visible — they just have no distance.
#
# Flip to `true` once the backlog is pinned; the admin vendor list marks which
# garages those are ("Not pinned").
GEO_REQUIRE_PIN=false

# Per-minute, per-IP cap on /geo/autocomplete and /geo/route — the two endpoints
# whose volume tracks browsing rather than saves, and so the only two that could
# burn the provider's free tier through ordinary use.
GEO_AUTOCOMPLETE_RATE_LIMIT=60

# ─── Usage events (Statistics → Funnel) ──────────────────────────────────────
# Batches of first-party usage events (POST /events) per IP per minute. Not
# counted against the global limit.
ANALYTICS_RATE_LIMIT=60
# E2E only: record events from headless browsers (Playwright), which are
# otherwise dropped with crawlers. The server refuses to boot with it in
# production.
ANALYTICS_ALLOW_HEADLESS=

# ─── Home hub ────────────────────────────────────────────────────────────────
# Whether an offer on Home may go to a chosen audience (customers who booked a
# garage, live near it, have a wash due, own a car type, or have never booked)
# rather than to everyone.
#
# Off unless set to `on`. Picking who sees an offer from booking history or
# location is a new use of personal data, so while this is off only 'everyone'
# offers reach Home and the admin API refuses to save any other audience (409
# TARGETING_DISABLED). Turn it on in the same release that updates the privacy
# policy. It only decides who sees an offer on Home; anyone may still type the
# code at checkout.
HOME_OFFER_TARGETING=off

# ─── AI (OpenAI) ─────────────────────────────────────────────────────────────
# Every AI feature in Detlio uses OpenAI on this one key: "Write with AI" for
# service descriptions and "Make a picture with AI" (about ₹4 a picture) for a
# service with no real photo, both in the admin editor, and reading a garage's
# poster, photo or PDF on Add garage. The key goes in the Vercel environment
# only — never in this file, in code or in git. Empty here, and with it empty
# the AI buttons are hidden and nothing is sent (the Tally CSV import needs no
# AI). Descriptions and pictures send only service facts and a garage's
# business name. The import sends the documents a garage gave us to join,
# which can carry the owner's name, phone and address (owner decision; the
# privacy policy says so); they are held in memory for the one request and
# never stored.
OPENAI_API_KEY=
# The model that writes the text. Change it in Vercel without a release.
AI_TEXT_MODEL=gpt-5.5
# The model that reads photos and PDFs for the garage import (image and PDF
# input, structured output). Change it in Vercel without a release.
AI_VISION_MODEL=gpt-5.5
# "Write with AI" calls per admin per hour (each one is a paid request).
AI_DESCRIBE_RATE_LIMIT=60
# Garage imports per admin per hour (a photo read is the dearest request).
AI_IMPORT_RATE_LIMIT=30
# OpenAI's alias for the ChatGPT image model; pin a dated model here if needed.
AI_IMAGE_MODEL=chatgpt-image-latest
# Presses of "Make 2 pictures" per admin per hour.
AI_PICTURES_PER_HOUR=20
# Tests only: 1 answers every text request with a fixed sentence and every
# picture request with a fixed test picture, and calls nothing. The server
# refuses to boot with it set while NODE_ENV=production.
AI_FAKE=

# ─── Start pilot clean ───────────────────────────────────────────────────────
# Whether the admin "Start pilot clean" tool exists: it deletes test bookings,
# refunds and checkouts for good, after a dry run and a typed confirmation.
#
# Off unless set to exactly `on`. While off every /admin/data-reset route is a
# 404 and the admin nav hides the page. Switch it on in Production only for
# the reset itself, after a database backup, and remove it straight after; the
# steps are in docs/test-data-reset.md. Marking a booking "Test" works either
# way.
ADMIN_DATA_RESET=off

# ─── Deployment (Vercel) ─────────────────────────────────────────────────────
# Set by the platform; listed so the full set is documented in one place.
VERCEL_EXPERIMENTAL_BACKENDS=
BACKEND_URL=
APP_VERSION=
