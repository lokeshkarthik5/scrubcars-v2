# ─── Detlio customer app — environment template ─────────────────────────────────────
#
# Copy to `.env` and fill in:
#
#   cp apps/users/.env.example apps/users/.env
#
# Anything prefixed NEXT_PUBLIC_ is inlined into the browser bundle. Never put a
# secret behind that prefix — the map provider key deliberately lives on the
# API instead (see apps/server/.env.example), which is why address search is
# proxied through /geo rather than called from the browser.

NODE_ENV=development

# Where the browser reaches the API.
#
# Production points straight at the API host. That works without weakening the
# session cookies because detlio.com, vendor.detlio.com, admin.detlio.com and
# api.detlio.com share the registrable domain detlio.com — the requests are
# same-site, so the SameSite=Lax cookies the API sets are still sent.
#
#   local        http://localhost:8080/api/v1
#   production   https://api.detlio.com/api/v1
#   preview      /api/v1   (see BACKEND_URL below)
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1

# Only used when NEXT_PUBLIC_API_URL is the relative /api/v1 form, which routes
# through this app's own proxy at app/api/v1/[...path]/route.ts.
#
# That path exists for preview deployments: *.vercel.app is on the Public
# Suffix List, so a preview URL is a different site from api.detlio.com and the
# Lax cookies would not be sent. Proxying keeps them first-party. Leave empty in
# production, where the direct URL above is used instead.
BACKEND_URL=

# Razorpay publishable key. Public by design — the secret stays server-side.
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx

# ─── Map tiles ───────────────────────────────────────────────────────────────
# Optional. Both default to OpenFreeMap, which needs no key, no registration
# and has no documented request limit — tiles are by far the highest-volume map
# call, so getting them to genuinely zero is the biggest cost lever.
#
# OpenFreeMap is a donation-funded public instance with no SLA, which is exactly
# why these are env vars: switching to MapTiler (100k requests/month free, no
# card) or Carto is a config change, not a code change.
#
# The app renders dark-only, so in practice only the DARK style is used — see
# MAP_THEME in packages/core/src/map.ts.
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron
NEXT_PUBLIC_MAP_STYLE_URL_DARK=https://tiles.openfreemap.org/styles/dark

# ─── Crash reporting (Sentry) ────────────────────────────────────────────────
# The DSN of this app's Sentry project. Public by design — it only lets
# someone send errors in, not read them — so the NEXT_PUBLIC_ prefix is fine.
# Unset (as in development, E2E and previews) and Sentry is never loaded and
# nothing is sent. Set it in the Vercel Production environment only; it is
# read at build time, so redeploy after changing it. No auth token or
# source-map upload is needed: builds never talk to Sentry.
NEXT_PUBLIC_SENTRY_DSN=
