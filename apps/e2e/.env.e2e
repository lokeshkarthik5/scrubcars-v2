# Committed on purpose — every value here is local-only and disposable.
# .gitignore has an explicit negation for this file.

# --- database (docker compose, port 5433 to stay clear of a dev Postgres) ---
DATABASE_URL=postgresql://detlio:detlio@localhost:55432/detlio_e2e?sslmode=disable
DIRECT_URL=postgresql://detlio:detlio@localhost:55432/detlio_e2e?sslmode=disable

# --- api ---
NODE_ENV=development
PORT=8080
JWT_SECRET=e2e-jwt-secret
CORS_ORIGIN=http://localhost:3000,http://localhost:3001,http://localhost:3002
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# --- payments -------------------------------------------------------------
# E2E_FAKE_PAYMENTS makes createRazorpayOrder mint an `order_e2e_*` id locally
# and makes verifyPaymentSignature accept exactly those ids. Every other order
# id still goes through the real HMAC. The server refuses to boot with this set
# while NODE_ENV=production.
E2E_FAKE_PAYMENTS=1
# Present only so getCredentials() doesn't 503 before the fake branch is hit.
RAZORPAY_KEY_ID=rzp_test_e2e
RAZORPAY_KEY_SECRET=e2e
RAZORPAY_WEBHOOK_SECRET=e2e-webhook

# --- rate limits ----------------------------------------------------------
# Production defaults are 10/min on auth and 100/min globally, keyed by IP.
# Every worker in this suite shares one IP, so the defaults would 429 within
# seconds. platform/reliability.spec.ts overrides these back down to assert the 429.
AUTH_RATE_LIMIT=10000
GLOBAL_RATE_LIMIT=100000

# Production keeps one database connection (apps/server/src/db/index.ts). The
# suite runs several files at once, and one connection would queue them all
# behind whichever test queried first. Advisory locks in the booking path are
# transaction-scoped, so extra connections do not hold a lock after commit.
PG_POOL_MAX=8

# --- storage (MinIO standing in for R2) ---
R2_ACCOUNT_ID=e2e
R2_ACCESS_KEY_ID=detlio
R2_SECRET_ACCESS_KEY=detlio-secret
R2_BUCKET=detlio-e2e
R2_ENDPOINT=http://localhost:9000
R2_PUBLIC_BASE_URL=http://localhost:9000/detlio-e2e
R2_MAX_PHOTOS_PER_VENDOR=5
R2_MAX_IMAGES_PER_SERVICE=3

# --- service videos (Cloudflare Stream, faked) ---------------------------
# STREAM_FAKE makes every video upload land on the API's own fake endpoint
# (/api/v1/fake-stream) and nothing reaches Cloudflare; a spec then fires the
# webhook itself, signed with the secret below (support/stream.ts). Video is
# off unless all four CLOUDFLARE_* are set, so they are set to throwaway
# values. The server refuses to boot with STREAM_FAKE while NODE_ENV=production.
STREAM_FAKE=1
STREAM_FAKE_BASE_URL=http://localhost:8080
CLOUDFLARE_ACCOUNT_ID=e2e-account
CLOUDFLARE_STREAM_API_TOKEN=e2e-token
CLOUDFLARE_STREAM_CUSTOMER_CODE=e2e
CLOUDFLARE_STREAM_WEBHOOK_SECRET=e2e-stream-webhook-secret

# --- deliberately unset ---------------------------------------------------
# SMS            -> OTPs are console-logged, never sent. Tests read the code
#                   out of otp_verifications rather than scraping stdout.
# OLA_MAPS_API_KEY -> /geo/* returns its clean 503 and the degraded map picker
#                   is itself asserted.

# --- Home hub ---------------------------------------------------------------
# Offers on Home may go to a chosen audience (booked this garage, near it,
# wash due…). Off in production until the privacy policy covers it; on here
# so the audience rules are exercised end to end. The Home fixtures' codes
# use those audiences on purpose, so no other spec's customer ever sees them.
HOME_OFFER_TARGETING=on

# --- Garage response deadline (0042) ---------------------------------------
# Off in production until the garages are told; on here so the cron's
# auto-cancel and the 409 on a late Accept are exercised end to end
# (specs/journeys/response-deadline-journey.spec.ts). Seeded bookings have no
# deadline (null), so nothing else is touched; a booking a spec makes gets at
# least 15 minutes, longer than any spec holds one pending.
AUTO_CANCEL_UNANSWERED=on
GARAGE_RESPONSE_MINUTES=30

# --- AI (OpenAI, faked) ----------------------------------------------------
# AI_FAKE answers every "Write with AI" request with one fixed sentence
# (FAKE_AI_TEXT in apps/server/src/lib/ai.ts), returns the same small PNG for
# every AI picture (FAKE_PICTURE in lib/ai-images.ts), and reads every photo or
# PDF on Add garage as the same poster (FAKE_GARAGE_READING in
# apps/server/src/lib/garage-import/vision.ts). It calls nothing, so the specs
# never reach OpenAI and need no key. OPENAI_API_KEY is empty on purpose, so a
# key in a developer's apps/server/.env is never read under the suite. The
# server refuses to boot with AI_FAKE while NODE_ENV=production.
AI_FAKE=1
OPENAI_API_KEY=
# Per admin per hour in production (60). Every spec signs in as the same
# admin, and a local server is reused across runs, so it is lifted here.
AI_DESCRIBE_RATE_LIMIT=10000
# Garage imports per admin per hour (30 in production), lifted for the same
# reason.
AI_IMPORT_RATE_LIMIT=10000

# --- test-data reset -----------------------------------------------------
# "Start pilot clean" in admin (ADMIN_DATA_RESET). Off in production except
# for the reset itself; on here so its specs run. They only ever delete the
# reset fixtures (BOOKINGS.reset*), by naming them, never a whole cutoff.
ADMIN_DATA_RESET=on

# --- frontends ---
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_e2e
# The new Home hub (apps/users/lib/home-hub.ts). On here, though production
# keeps it off until the owner signs it off, so /home is the hub and its @p0
# specs (specs/users/home.spec.ts, updates.spec.ts) run on every PR; the
# garage list is checked at /garages. Set explicitly so an
# apps/users/.env.local cannot turn it off under the suite. CI builds the apps
# without this file — keep e2e.yml's Build step in step.
NEXT_PUBLIC_HOME_HUB=on

# --- ops alerts -----------------------------------------------------------
# Empty on purpose. dotenv never overrides a key that is already set, so these
# keep a Telegram token in a developer's apps/server/.env from posting seeded
# bookings to the real team group. (The server also refuses to alert outside
# Production and with E2E_FAKE_PAYMENTS on — this is the belt to that brace.)
TELEGRAM_BOT_TOKEN=
TELEGRAM_OPS_CHAT_ID=

# --- scheduled jobs -------------------------------------------------------
# A fixed test secret so platform/ops-jobs.spec.ts can call the endpoint. Alerts
# stay off here regardless (see above), so a run never posts anything.
CRON_SECRET=e2e-cron-secret-0123456789abcdef0123456789abcdef0123456789
