{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "NODE_ENV"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "dist/**"
      ],
      "env": [
        "ADMIN_PASSWORD",
        "ADMIN_USERNAME",
        "AUTH_RATE_LIMIT",
        "BACKEND_URL",
        "CORS_ORIGIN",
        "DATABASE_URL",
        "DIRECT_URL",
        "E2E_FAKE_PAYMENTS",
        "GEO_AUTOCOMPLETE_RATE_LIMIT",
        "GEO_CACHE_TTL_HOURS",
        "GEO_PROVIDER",
        "GLOBAL_RATE_LIMIT",
        "JWT_SECRET",
        "NEXT_PUBLIC_API_URL",
        "NEXT_PUBLIC_APP_VERSION",
        "NEXT_PUBLIC_MAP_STYLE_URL",
        "NEXT_PUBLIC_MAP_STYLE_URL_DARK",
        "NEXT_PUBLIC_RAZORPAY_KEY_ID",
        "NEXT_PUBLIC_SENTRY_DSN",
        "OLA_MAPS_API_KEY",
        "OLA_MAPS_ORIGIN",
        "R2_ACCESS_KEY_ID",
        "R2_ACCOUNT_ID",
        "R2_BUCKET",
        "R2_ENDPOINT",
        "R2_PUBLIC_BASE_URL",
        "R2_SECRET_ACCESS_KEY",
        "RAZORPAY_KEY_ID",
        "RAZORPAY_KEY_SECRET",
        "RAZORPAY_WEBHOOK_SECRET",
        "SENTRY_DSN",
        "SMS",
        "VERCEL_ENV",
        "VERCEL_EXPERIMENTAL_BACKENDS"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "typecheck": {
      "dependsOn": [
        "^build"
      ]
    },
    "test": {},
    "test:e2e": {
      "cache": false,
      "dependsOn": [
        "^build"
      ],
      "env": [
        "AUTH_RATE_LIMIT",
        "CI",
        "DATABASE_URL",
        "DIRECT_URL",
        "E2E_FAKE_PAYMENTS",
        "GLOBAL_RATE_LIMIT",
        "R2_ENDPOINT"
      ]
    }
  }
}
