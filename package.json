{
  "name": "detlio",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "turbo run dev",
    "dev:api": "turbo run dev --filter=server",
    "dev:users": "turbo run dev --filter=users",
    "dev:vendors": "turbo run dev --filter=vendors",
    "dev:admin": "turbo run dev --filter=admin",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "seed": "bun run --filter server seed",
    "migrate": "bun run --filter server migrate",
    "migrate:status": "bun run --filter server migrate:status",
    "test": "turbo run test",
    "test:e2e": "bun run --filter @repo/e2e test:e2e",
    "test:e2e:p0": "bun run --filter @repo/e2e test:e2e:p0",
    "e2e:up": "bun run --filter @repo/e2e db:up",
    "e2e:down": "bun run --filter @repo/e2e db:down",
    "e2e:reset": "bun run --filter @repo/e2e db:reset"
  },
  "devDependencies": {
    "prettier": "^3.9.0",
    "turbo": "^2.5.8"
  }
}
