{
  "name": "detlio",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev --prefix server\" \"npm run dev --prefix web\"",
    "dev:api": "npm run dev --prefix server",
    "dev:web": "npm run dev --prefix web",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "seed": "npm run seed --prefix server"
  },
  "devDependencies": {
    "concurrently": "^8.0.0",
    "playwright": "^1.62.1",
    "prettier": "^3.9.0"
  }
}
